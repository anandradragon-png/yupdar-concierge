# Port for the concierge web server
PORT=3100

# YupDar core API (closed source). The concierge talks to it over HTTPS only.
CORE_API_URL=https://yupdar.com/api/concierge
CORE_API_KEY=

# Language model: any OpenAI-compatible chat completions API. DeepSeek by default.
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-chat
# Optional second model tried when the first one fails
LLM_MODEL_FALLBACK=
