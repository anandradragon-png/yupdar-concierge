# Port for the concierge web server
PORT=3100

# YupDar core API (closed source). The concierge talks to it over HTTPS only.
CORE_API_URL=https://yupdar.com/api/concierge
CORE_API_KEY=

# Nebius Token Factory (NVIDIA Nemotron). Get a key at tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_FALLBACK=nvidia/nvidia-nemotron-3-nano-30b-a3b
